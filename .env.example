# MikroTik CCR1036 — usuário com grupo "read" (somente leitura)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=monitor
# Use aspas se a senha tiver # ou espaços
MIKROTIK_PASSWORD="troque_esta_senha"

# Poller (PPPoE — online/offline)
POLL_INTERVAL_MS=10000
# Poller lento (CPU/memória/temperatura, log, amostra de banda, limpeza)
SYSTEM_POLL_INTERVAL_MS=60000
# Quantos dias manter no histórico (system_stats, bandwidth_samples, log_events)
RETENTION_DAYS=30

# Webhook opcional (Telegram/Slack/n8n) — POST em JSON quando o CCR cai/volta
WEBHOOK_URL=
# Também notificar quando um cliente específico conecta/desconecta (pode ser bem barulhento)
WEBHOOK_NOTIFY_CLIENTS=false

# Push (app MonitorZcnet) — alerta de queda em massa (mesma porta/região caindo junto)
OUTAGE_ALERT_THRESHOLD=3
OUTAGE_ALERT_WINDOW_MINUTES=5
OUTAGE_ALERT_COOLDOWN_MINUTES=30

# Server
PORT=3001
HOST=0.0.0.0

# Login da tela (não é usuário do MikroTik)
AUTH_USER=admin
AUTH_PASSWORD="troque_esta_senha"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_SESSION_HOURS=12
